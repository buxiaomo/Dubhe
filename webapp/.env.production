ENV = 'production'

# 默认BASE URL
VUE_APP_BASE_API = '/'

# TODO: 目前后端连接位于 8960端口 k8s 服务，需要后端调整后再同步调整
# WebSocket 连接地址
VUE_APP_WS_API = 'ws://DUBHE_BACKEND_SERVER:8960/ws'

# 数据管理
VUE_APP_DATA_API = '/'

# 训练可视化
VUE_APP_VISUAL_API = '/'

# minio
VUE_APP_MINIO_API = 'http://DUBHE_MINIO_SERVER:DUBHE_MINIO_PORT/minio'

# atlas
VUE_APP_ATLAS_HOST = 'http://127.0.0.1'

# DCM4CHEE
VUE_APP_DCM_API = 'http://DUBHE_WEB_SERVER/dcm4chee/dcm4chee-arc/aets/DCM4CHEE_ADMIN'

# minIO 服务 IP
VUE_APP_MINIO_ENDPOINT = 'DUBHE_MINIO_SERVER'
# minIO 服务 端口
VUE_APP_MINIO_PORT = 'DUBHE_MINIO_PORT'
# 是否开启 SSL
VUE_APP_MINIO_USESSL = 'false'
# bucketName
VUE_APP_MINIO_BUCKETNAME = 'DUBHE_ENVIRONMENT'

# 文档链接
VUE_APP_DOCS_URL = http://docs.tianshu.org.cn/docs/
